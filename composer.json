{
    "name": "nuewire/support",
    "description": "Shared Laravel utilities for Nuewire packages.",
    "keywords": [
        "laravel",
        "nuewire",
        "support",
        "random-id"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nuewire"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Nuewire\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nuewire\\Support\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nuewire\\Support\\SupportServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
